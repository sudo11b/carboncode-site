{
  "name": "l3sa-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply l3sa-demo --local",
    "db:seed:local": "wrangler d1 execute l3sa-demo --local --file=db/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply l3sa-demo --remote",
    "db:seed:remote": "wrangler d1 execute l3sa-demo --remote --file=db/seed.sql",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "astro": "^7.3.8",
    "wrangler": "^4.150.0"
  }
}
