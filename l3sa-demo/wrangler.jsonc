{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "l3sa-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  // Astro builds static HTML into ./dist. The Worker only runs for /api/*;
  // every other path is served straight from the asset store.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "l3sa-demo",
      "database_id": "eb456a3a-0d3d-4f4f-8000-c0763eb0d77f",
      "migrations_dir": "migrations"
    }
  ],

  "routes": [{ "pattern": "l3sa.carboncode.app", "custom_domain": true }],

  // Lets the Worker `import seedSql from "../db/seed.sql"` for the Reset button.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
