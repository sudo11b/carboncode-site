---
import '../styles/global.css';
import { strings } from '../i18n/strings';

interface Props {
  /** Admin is English-only, so its banner and title aren't translated. */
  admin?: boolean;
  title?: string;
}
const { admin = false, title } = Astro.props;
const pageTitle = title ?? strings.en['meta.title'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title data-i18n-title={admin ? undefined : 'meta.title'}>{pageTitle}</title>
    <meta name="description" content={strings.en['meta.description']} />
    <meta name="theme-color" content="#9b1b1b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700;800&display=swap" rel="stylesheet" />
    {!admin && (
      <script is:inline>
        // Apply the saved language before first paint to avoid an English flash.
        (function () {
          try {
            var q = new URLSearchParams(location.search).get('lang');
            var l = q === 'es' || q === 'en' ? q : localStorage.getItem('l3sa-lang');
            if (l === 'es') document.documentElement.lang = 'es';
          } catch (e) {}
        })();
      </script>
    )}
  </head>
  <body>
    <div class="preview-banner" role="status">
      {admin ? 'PREVIEW — not accepting real registrations' : <span data-i18n="banner">{strings.en.banner}</span>}
    </div>
    <slot />
  </body>
</html>
