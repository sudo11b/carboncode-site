---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
---
<Base admin title="L3SA Admin (Preview)">
  <header class="site-header">
    <div class="wrap wrap-wide">
      <Wordmark href="/admin" />
      <a class="btn btn-secondary btn-small" href="/" target="_blank" rel="noopener">View public page ↗</a>
    </div>
  </header>

  <main class="wrap wrap-wide">
    <div class="admin-top">
      <h1>Admin</h1>
      <button type="button" class="btn btn-danger btn-small" id="reset-demo">Reset demo data</button>
    </div>
    <p class="hint" style="margin:0">No login on this preview. The live version will be password-protected.</p>

    <nav class="tabs" role="tablist" aria-label="Admin sections">
      <button class="tab" role="tab" id="tab-btn-classes" aria-controls="tab-classes" data-tab="classes">Classes</button>
      <button class="tab" role="tab" id="tab-btn-info" aria-controls="tab-info" data-tab="info">Info requests <span class="count-pill" id="info-count" hidden></span></button>
      <button class="tab" role="tab" id="tab-btn-emails" aria-controls="tab-emails" data-tab="emails">Email log</button>
    </nav>

    <div id="flash" class="result-panel" aria-live="polite"></div>

    <section id="tab-classes" role="tabpanel" aria-labelledby="tab-btn-classes"></section>
    <section id="tab-info" role="tabpanel" aria-labelledby="tab-btn-info" hidden></section>
    <section id="tab-emails" role="tabpanel" aria-labelledby="tab-btn-emails" hidden></section>
  </main>

  <script>
    import '../scripts/admin.ts';
  </script>
</Base>
