---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Wordmark from '../components/Wordmark.astro';
---
<Base title="Page not found | L3SA">
  <header class="site-header"><div class="wrap"><Wordmark /></div></header>
  <main class="wrap section">
    <h1>404</h1>
    <p><a class="btn btn-primary" href="/"><T k="form.back" /></a></p>
  </main>
  <script>
    import { applyStatic } from '../scripts/i18n';
    applyStatic();
  </script>
</Base>
